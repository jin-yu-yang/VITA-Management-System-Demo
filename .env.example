# Browser configuration for the local demo server.
#
# Copy to `.env.local` (git-ignored) and fill in the values of the Supabase
# project the demo should talk to. `npm start` loads it with
# `--env-file-if-exists`, so the server also starts without this file: the app
# then fetches `./public-config.json`, reads `{"configured": false}` and shows
# its setup-needed screen instead of a login form.
#
# Only these three values ever reach the browser, and only through
# `/public-config.json`. Administrative keys, database URLs and SMTP
# credentials belong in `.env.test` / `.env.admin` and are never served.

# The project's API URL, for example http://127.0.0.1:57321 locally or
# https://<project-ref>.supabase.co when hosted.
SUPABASE_URL=

# The publishable (anonymous) key. It is a public client identifier, not a
# secret; the secret/service-role key must never be put here.
SUPABASE_PUBLISHABLE_KEY=

# How long the sign-in screen waits before another code can be requested. Set
# it to the project's own minimum email interval plus five seconds — 65 for the
# verified 60-second setting. It is the same for every visitor, so the wait
# reveals nothing about who has an account. A missing or non-positive value
# falls back to 65.
AUTH_RESEND_COOLDOWN_SECONDS=65
