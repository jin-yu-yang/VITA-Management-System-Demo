{
  "name": "pcdc-vita-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local two-minute PCDC VITA presentation prototype",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
