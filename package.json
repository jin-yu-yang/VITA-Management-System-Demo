{
  "name": "pcdc-vita-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ViTally: a Supabase-backed shared demonstration of a VITA tax-prep workflow — real email sign-in, real shared state between a client and a staff window, simulated documents and preparation steps",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "dev": "node --env-file-if-exists=.env.local server.mjs",
    "build:vendor": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --env-file=.env.test --test tests/browser.mjs",
    "test:auth-browser": "node --env-file=.env.test --test tests/auth-browser.mjs",
    "test:database": "node --env-file=.env.test --test tests/database*.mjs",
    "db:migrate:test": "node --env-file=.env.test tools/admin/migrate.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "supabase": "2.117.0"
  }
}
